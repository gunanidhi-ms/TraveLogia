<% layout("/layouts/boilerplate") %>

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold mb-1"><i class="fa-solid fa-suitcase-rolling text-danger me-2"></i>My Trips & Bookings</h2>
            <p class="text-muted mb-0">Manage your past and upcoming reservations</p>
        </div>
        <a href="/listings" class="btn btn-outline-danger">
            <i class="fa-solid fa-compass me-1"></i> Explore More Stays
        </a>
    </div>

    <% if (!bookings || bookings.length === 0) { %>
        <div class="card border-0 shadow-sm text-center py-5 my-4">
            <div class="card-body">
                <i class="fa-solid fa-map-location-dot text-muted" style="font-size: 4rem;"></i>
                <h4 class="mt-3 fw-semibold">No reservations found yet!</h4>
                <p class="text-muted mx-auto" style="max-width: 480px;">
                    Time to dust off your bags and start planning your next getaway. Explore scenic villas, mountain cabins, beach retreats, and more.
                </p>
                <a href="/listings" class="btn btn-danger btn-lg mt-2 px-4">
                    Start Exploring
                </a>
            </div>
        </div>
    <% } else { %>
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            <% for (let b of bookings) { %>
                <div class="col">
                    <div class="card h-100 shadow-sm border-0 rounded-4 overflow-hidden position-relative">
                        <% if (b.listing && b.listing.image && b.listing.image.url) { %>
                            <img src="<%= b.listing.image.url %>" class="card-img-top" alt="<%= b.listing.title %>" style="height: 200px; object-fit: cover;">
                        <% } else { %>
                            <div class="bg-light d-flex align-items-center justify-content-center text-muted" style="height: 200px;">
                                <i class="fa-solid fa-image fa-2x"></i>
                            </div>
                        <% } %>

                        <span class="position-absolute top-0 end-0 m-3 badge rounded-pill <%= b.status === 'Confirmed' ? 'bg-success' : 'bg-secondary' %> px-3 py-2 shadow-sm">
                            <i class="fa-solid <%= b.status === 'Confirmed' ? 'fa-circle-check' : 'fa-ban' %> me-1"></i>
                            <%= b.status %>
                        </span>

                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title fw-bold text-truncate mb-1">
                                <% if (b.listing) { %>
                                    <a href="/listings/<%= b.listing._id %>" class="text-decoration-none text-dark">
                                        <%= b.listing.title %>
                                    </a>
                                <% } else { %>
                                    <span class="text-muted">Listing Archived</span>
                                <% } %>
                            </h5>
                            
                            <% if (b.listing) { %>
                                <p class="text-muted small mb-2">
                                    <i class="fa-solid fa-location-dot text-danger me-1"></i>
                                    <%= b.listing.location %>, <%= b.listing.country %>
                                </p>
                            <% } %>

                            <div class="bg-light rounded-3 p-2 mb-3 small">
                                <div class="d-flex justify-content-between text-muted mb-1">
                                    <span>Check-in:</span>
                                    <span class="fw-semibold text-dark">
                                        <%= new Date(b.checkIn).toLocaleDateString("en-IN", { day: "numeric", month: "short", year: "numeric" }) %>
                                    </span>
                                </div>
                                <div class="d-flex justify-content-between text-muted mb-1">
                                    <span>Check-out:</span>
                                    <span class="fw-semibold text-dark">
                                        <%= new Date(b.checkOut).toLocaleDateString("en-IN", { day: "numeric", month: "short", year: "numeric" }) %>
                                    </span>
                                </div>
                                <div class="d-flex justify-content-between text-muted">
                                    <span>Stay Details:</span>
                                    <span class="fw-semibold text-dark">
                                        <%= b.totalNights %> night<%= b.totalNights > 1 ? 's' : '' %> &bull; <%= b.guests %> guest<%= b.guests > 1 ? 's' : '' %>
                                    </span>
                                </div>
                            </div>

                            <div class="mt-auto pt-2 border-top d-flex justify-content-between align-items-center">
                                <div>
                                    <small class="text-muted d-block">Total Paid</small>
                                    <span class="fw-bold text-danger fs-5">&#8377; <%= b.totalPrice.toLocaleString("en-IN") %></span>
                                </div>
                                <div class="text-end">
                                    <small class="text-muted d-block font-monospace"><%= b.bookingCode %></small>
                                    <a href="/bookings/<%= b._id %>" class="btn btn-sm btn-outline-dark mt-1">
                                        Voucher <i class="fa-solid fa-arrow-right ms-1"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            <% } %>
        </div>
    <% } %>
</div>

