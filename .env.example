# ===================================================
# TraveLogia / WanderLust - Environment Variables
# ===================================================
# STEP 1: Copy this file and rename it to ".env"
#         cp .env.example .env
#
# STEP 2: Fill in each value below with your real credentials
# ===================================================

# MongoDB Atlas connection string
# Get from: https://cloud.mongodb.com → Connect → Drivers → Node.js
ATLASDB_URL=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/wanderlust?retryWrites=true&w=majority

# Session secret - any long random string works
SECRET=replaceThisWithALongRandomSecretString

# Cloudinary credentials
# Get from: https://cloudinary.com → Dashboard
CLOUD_NAME=your_cloudinary_cloud_name
CLOUD_API_KEY=your_cloudinary_api_key
CLOUD_API_SECRET=your_cloudinary_api_secret

# Mapbox public token
# Get from: https://account.mapbox.com → Tokens
MAP_TOKEN=pk.eyJ1IjoiWU9VUl9VU0VSTkFNRSIsImEiOiIuLi4ifQ.your_token_here
